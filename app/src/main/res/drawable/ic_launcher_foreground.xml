<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher mark: three morse elements (dot, dash, dot) in the accent ink colour,
  drawn inside the 72dp adaptive-icon safe zone of the 108dp canvas. The ink
  comes from @color/ic_launcher_ink so the glyph and the themed (monochrome)
  layer share one definition.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/ic_launcher_ink"
        android:pathData="M30,54m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0" />
    <path
        android:fillColor="@color/ic_launcher_ink"
        android:pathData="M46,48h16a6,6 0,0 1,0 12h-16a6,6 0,0 1,0 -12z" />
    <path
        android:fillColor="@color/ic_launcher_ink"
        android:pathData="M78,54m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0" />
</vector>
