<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup policy (API <= 30).

  Only the DataStore directory is backed up, so the user's settings survive a
  restore while everything else stays on the device: the Room database holds
  logs, crash reports and transfer history — private records of what the user
  shared — and in-flight partial files, text exports and the cache are transient.

  Those are not listed as <exclude> entries on purpose. As soon as a
  full-backup-content file declares an <include>, every path outside it is
  already left out, and lint's FullBackupContent check rejects an <exclude> whose
  path is not inside an included path.
-->
<full-backup-content>
    <include domain="file" path="datastore/" />
</full-backup-content>
