<?xml version="1.0" encoding="utf-8"?>
<!--
  Same policy as backup_rules.xml, for the API 31+ extraction engine: settings
  travel with the user, private records and transient files do not.

  <cloud-backup> covers backup to Google Drive; <device-transfer> covers a
  direct device-to-device copy. Both are include-only, because an <exclude> for
  a path that is not inside an <include> is redundant and lint rejects it.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
